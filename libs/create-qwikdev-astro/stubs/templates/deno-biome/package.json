{
  "name": "@qwik.dev/astro-node-biome-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "build": "npm run fix && astro build",
    "check": "biome ci . && astro check",
    "check.format": "biome format .",
    "check.lint": "biome check .",
    "deploy": "deployctl deploy --project=qwik-astro --no-static --include=./dist ./dist/server/entry.mjs",
    "dev": "astro dev",
    "fix": "npm run lint && npm run format && npm run sync",
    "format": "biome format --write .",
    "lint": "biome check --write --unsafe .",
    "preview": "npm run build && npm run serve",
    "prod": "npm run build && npm run deploy",
    "serve": "deno run -A --unstable ./dist/server/entry.mjs",
    "start": "astro dev --open"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@deno/astro-adapter": "^0.3.1",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@9d29f75",
    "@qwik.dev/astro": "https://pkg.pr.new/QwikDev/astro/@qwik.dev/astro@6ed9ed1",
    "astro": "^6.0.6",
    "typescript": "^5.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.6.3"
  }
}