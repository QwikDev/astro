{
  "name": "qwikdev-astro",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm -C ./apps/demo dev",
    "start": "pnpm -C ./apps/demo start",
    "build": "pnpm -C ./apps/demo build",
    "preview": "pnpm -C ./apps/demo preview",
    "node.dev": "pnpm -C ./apps/node-demo dev",
    "node.start": "pnpm -C ./apps/node-demo start",
    "node.build": "pnpm -C ./apps/node-demo build",
    "node.preview": "pnpm -C ./apps/node-demo preview",
    "deno.dev": "pnpm -C ./apps/deno-demo dev",
    "deno.start": "pnpm -C ./apps/deno-demo start",
    "deno.build": "pnpm -C ./apps/deno-demo build",
    "deno.preview": "pnpm -C ./apps/deno-demo preview",
    "docs.dev": "pnpm -C ./apps/website dev",
    "docs.start": "pnpm -C ./apps/website start",
    "docs.build": "pnpm -C ./apps/website build",
    "docs.preview": "pnpm -C ./apps/website preview",
    "check": "biome ci .",
    "check.format": "biome format .",
    "check.lint": "biome check .",
    "fix": "pnpm lint && pnpm format",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "build.create-qwikdev-astro": "pnpm -C ./libs/create-qwikdev-astro prod",
    "postinstall": "test \"$NETLIFY\" = 'true' && exit 0 || lefthook install && playwright install --with-deps",
    "changeset": "changeset",
    "release": "pnpm build.create-qwikdev-astro && changeset publish",
    "test": "pnpm test.cli && pnpm test.platform",
    "test.cli": "pnpm -C ./libs/create-qwikdev-astro test",
    "test.platform": "playwright test --pass-with-no-tests",
    "test.platform.ui": "playwright test --ui",
    "test.platform.report": "playwright show-report"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "esbuild",
      "lefthook",
      "sharp"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.29.4",
    "@playwright/test": "^1.58.2",
    "@qwik.dev/astro": "workspace:*",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@324116a",
    "@qwikdev/create-astro": "workspace:*",
    "@types/node": "^22.15.31",
    "astro": "6.0.6",
    "lefthook": "^1.11.13",
    "pkg-pr-new": "^0.0.35",
    "vitest": "^4.0.18"
  }
}
