---
import { ClientRouter } from "astro:transitions";
import { JSChunkAnimator } from "@components/home/js-chunk-animator/js-chunk-animator";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const ogImage = "https://astro.qwik.dev/og/index.png";

import "@fontsource-variable/unbounded";
import "@fontsource/yusei-magic";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Qwik + Astro integration" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={title} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<script is:inline>
			function setDarkMode(document) {
				let theme = localStorage.getItem("darkMode") || "dark";
				document.documentElement.className = theme;
			}
			setDarkMode(document);
			document.addEventListener("astro:before-swap", (ev) => {
				setDarkMode(ev.newDocument);
				ev.newDocument.documentElement.setAttribute("data-revisit", "");
			});
		</script>
		<slot />
		<JSChunkAnimator />
	</body>
</html>
