---
import DocsLayout from "@layouts/docs/DocsLayout.astro";
import { Code } from "astro:components";
---

<DocsLayout title="JSX Frameworks" currentPath="/docs/jsx-frameworks">
  <section class="docs-hero">
    <span class="docs-label">Multi-framework</span>
    <h1>Using multiple JSX frameworks</h1>
    <p class="docs-intro">
      Use Qwik alongside React, Preact, or Solid in the same Astro
      project by configuring include paths.
    </p>
  </section>

  <section class="docs-section">
    <h2>Framework include paths</h2>
    <p>
      Set up rules for which files each framework should handle. Place
      all Qwik components in a folder named <code>qwik</code>, then
      configure Astro to process files within that folder.
    </p>
    <div class="code-block">
      <div class="code-header">
        <span class="code-filename">astro.config.mjs</span>
      </div>
      <div class="code-body">
        <Code
          code={`import { defineConfig } from "astro/config";
import qwik from "@qwik.dev/astro";
import react from "@astrojs/react";

export default defineConfig({
  integrations: [
    qwik({ include: "**/qwik/*" }),
    react({ include: "**/react/*" }),
    solid({ include: "**/solid/*" }),
  ],
});`}
          lang="ts"
          theme="github-dark"
        />
      </div>
    </div>
    <p>
      For simplicity, consider grouping common framework components
      in the same folder (like <code>/components/react/</code> and
      <code>/components/qwik/</code>). However, this is optional.
    </p>
  </section>

  <section class="docs-section">
    <h2>Qwik React</h2>
    <p>
      If you're using React, use the
      <a href="https://qwik.dev/docs/integrations/react/">Qwik-React integration</a>.
      It's a drop-in replacement for <code>@astrojs/react</code>,
      and allows a seamless transition to Qwik.
    </p>
    <div class="code-block">
      <div class="code-header">
        <span class="code-filename">astro.config.mjs</span>
      </div>
      <div class="code-body">
        <Code
          code={`import { defineConfig } from "astro/config";
import qwik from "@qwik.dev/astro";
import { qwikReact } from "@qwik.dev/react/vite";

export default defineConfig({
  integrations: [qwik()],
  vite: {
    plugins: [qwikReact()],
  },
});`}
          lang="ts"
          theme="github-dark"
        />
      </div>
    </div>
    <p>A React component with the qwik-react integration:</p>
    <div class="code-block">
      <div class="code-header">
        <span class="code-filename">react-counter.tsx</span>
      </div>
      <div class="code-body">
        <Code
          code={`/** @jsxImportSource react */
import { qwikify$ } from "@qwik.dev/react";
import { useState } from "react";

const ReactCounter = () => {
  const [count, setCount] = useState(0);

  return (
    <button onClick={() => setCount(count + 1)}>
      React {count}
    </button>
  );
};

// "Qwikified" React component
export const QReactCounter = qwikify$(ReactCounter);`}
          lang="tsx"
          theme="github-dark"
        />
      </div>
    </div>
    <p>Then consume it in an Astro file:</p>
    <div class="code-block">
      <div class="code-header">
        <span class="code-filename">index.astro</span>
      </div>
      <div class="code-body">
        <Code
          code={`<QReactCounter qwik:visible />`}
          lang="astro"
          theme="github-dark"
        />
      </div>
    </div>
    <p>
      Notice the <code>qwik:</code> hydration directive prefix — this
      prevents a conflict with Astro's built-in hydration directives.
      You can also use the <code>client:*</code> prefix, but only in
      tsx files.
    </p>
    <blockquote>
      Qwik React components still have hydration. It is recommended
      to use Qwik-React as a migration strategy to resumable
      components.
    </blockquote>
  </section>

  <section class="docs-section">
    <h2>jsxImportSource</h2>
    <p>
      TypeScript can only have one <code>jsxImportSource</code>
      default. If you're using React, Solid, or Preact alongside
      Qwik, override each component's import source.
    </p>
    <div class="code-block">
      <div class="code-header">
        <span class="code-filename">react-component.tsx</span>
      </div>
      <div class="code-body">
        <Code
          code={`/** @jsxImportSource react */
import { useState } from "react";

export const ReactCounter = () => {
  const [count, setCount] = useState(0);
  return (
    <button onClick={() => setCount(count + 1)}>
      {count}
    </button>
  );
};`}
          lang="tsx"
          theme="github-dark"
        />
      </div>
    </div>
    <p>For Solid JS:</p>
    <div class="code-block">
      <div class="code-body">
        <Code
          code={`/** @jsxImportSource solid-js */`}
          lang="tsx"
          theme="github-dark"
        />
      </div>
    </div>
    <p>For Preact:</p>
    <div class="code-block">
      <div class="code-body">
        <Code
          code={`/** @jsxImportSource preact */`}
          lang="tsx"
          theme="github-dark"
        />
      </div>
    </div>
  </section>
</DocsLayout>

<style>
  .docs-hero {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--neutral-950);
    margin-bottom: var(--space-xl);
  }

  .docs-label {
    font-size: 10px;
    color: var(--rose-500);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-2xs);
  }

  h1 { font-size: var(--step-5); margin-bottom: var(--space-m); }

  .docs-intro {
    font-size: var(--step-1);
    color: var(--neutral-400);
    max-width: 48ch;
    line-height: 1.7;
  }

  .docs-section {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--neutral-950);
    margin-bottom: var(--space-xl);
  }

  .docs-section:last-child { border-bottom: none; }

  h2 { font-size: var(--step-2); margin-bottom: var(--space-m); }

  p {
    font-size: var(--step-0);
    color: var(--neutral-400);
    line-height: 1.7;
    margin-bottom: var(--space-m);
    max-width: 60ch;
  }

  p code {
    color: var(--green-400);
    font-family: monospace;
    font-size: 0.9em;
  }

  a { color: var(--purple-300); text-underline-offset: 4px; }

  blockquote {
    border-left: var(--space-4xs) dotted var(--rose-500);
    padding-left: var(--space-m);
    margin-bottom: var(--space-m);
    color: var(--neutral-400);
    font-size: var(--step-0);
    line-height: 1.7;
    font-style: italic;
  }

  .code-block {
    border: 1px solid var(--neutral-950);
    margin-bottom: var(--space-m);
    overflow: hidden;
  }

  .code-header {
    background-color: #1a1a1a;
    padding: var(--space-3xs) var(--space-m);
    border-bottom: 1px solid var(--neutral-950);
  }

  .code-filename {
    font-size: 10px;
    color: var(--neutral-400);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  .code-body {
    padding: var(--space-m);
    background-color: #151515;
  }

  .code-body :global(pre) {
    background: transparent !important;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }
</style>
