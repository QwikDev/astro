{
  "name": "@qwik.dev/astro-website",
  "type": "module",
  "private": true,
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "build": "pnpm fix && astro build && pagefind --site dist && cp -r dist/pagefind public/pagefind",
    "check": "biome ci . && astro check",
    "check.format": "biome format .",
    "check.lint": "biome check .",
    "dev": "astro dev --host",
    "fix": "pnpm lint && pnpm format",
    "format": "biome format --write .",
    "lint": "biome check --apply-unsafe .",
    "preview": "pnpm build && astro preview",
    "prod": "pnpm check && astro build",
    "start": "astro dev --open"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.3",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@fontsource/yusei-magic": "^5.2.8",
    "@iconify-json/lucide": "^1.2.99",
    "@qds.dev/ui": "^0.14.3",
    "@qwik.dev/astro": "workspace:*",
    "@qwik.dev/core": "2.0.0-beta.30",
    "astro": "6.0.6",
    "astro-icon": "^1.1.5",
    "pagefind": "^1.4.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
